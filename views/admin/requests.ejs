<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>
<div class="wrap panel-body">
  <p class="small muted">Gestión semimanual: si un pedido no tiene propuestas, avisale a los comercios del rubro por WhatsApp con un clic.</p>
  <div class="table-wrap"><table class="table">
    <tr><th>Pedido</th><th>Vecino</th><th class="num">Propuestas</th><th>Estado</th><th>Acciones</th></tr>
    <% list.forEach(function(rq){ %>
    <tr>
      <td><%= rq.category_icon %> <a href="/busco-ya/p/<%= rq.token %>" target="_blank"><%= rq.description.slice(0, 110) %><%= rq.description.length > 110 ? '…' : '' %></a><br>
        <span class="small muted"><%= timeAgo(rq.created_at) %><%= rq.budget ? ' · ' + fmtPrice(rq.budget) : '' %><%= rq.zone ? ' · ' + rq.zone : '' %> · llega a <%= rq.matches.length %> comercio<%= rq.matches.length === 1 ? '' : 's' %></span>
        <% if (rq.status === 'open' && !rq.expired && rq.matches.length) { %>
        <details class="small"><summary>Avisar a comercios del rubro</summary>
          <% rq.matches.forEach(function(b){ if (!b.whatsapp) return; %>
            <a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="<%= waLink(b.whatsapp, 'Hola ' + b.name + '! Hay un pedido nuevo en BUSCO YA de Pulso Luján: "' + rq.description.slice(0, 140) + '". Respondelo desde tu panel: ' + baseUrl + '/panel/pedidos') %>"><%= b.name %></a>
          <% }) %>
        </details>
        <% } %>
      </td>
      <td class="small"><%= rq.name %><br><a href="<%= waLink(rq.whatsapp) %>" target="_blank" rel="noopener">+<%= rq.whatsapp %></a></td>
      <td class="num"><%= rq.proposals %></td>
      <td><span class="tag <%= rq.status === 'open' && !rq.expired ? 'tag-open' : rq.status === 'hidden' ? 'tag-closed' : '' %>"><%= rq.status === 'hidden' ? 'Oculto' : rq.status === 'closed' ? 'Cerrado' : rq.expired ? 'Vencido' : 'Activo' %></span></td>
      <td class="nowrap">
        <form method="post" action="/admin/pedidos/<%= rq.id %>/estado" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (rq.status !== 'hidden') { %><button class="btn btn-ghost btn-sm danger" name="status" value="hidden">Ocultar</button><% } else { %><button class="btn btn-ghost btn-sm" name="status" value="open">Restaurar</button><% } %>
        </form>
      </td>
    </tr>
    <% }) %>
    <% if (!list.length) { %><tr><td colspan="5" class="muted">Sin pedidos todavía.</td></tr><% } %>
  </table></div>
</div>
<%- include('../partials/footer') %>
