<%- include('../partials/header') %>
<%- include('../partials/panel-nav') %>
<div class="wrap panel-body">
  <form class="card form-card" method="post" action="/panel/productos/<%= product.id || 'nuevo' %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2><%= product.id ? 'Editar producto' : 'Nuevo producto' %></h2>
    <% if (error) { %><div class="flash flash-warn"><%= error %></div><% } %>
    <div class="field"><span>Foto</span>
      <div class="photo-pick">
        <img data-preview src="<%= product.photo || '' %>" alt="" class="<%= product.photo ? '' : 'hidden' %>">
        <input type="file" name="photo" accept="image/*" data-preview-input>
      </div>
      <% if (product.photo) { %><label class="check small"><input type="checkbox" name="remove_photo" value="1"> Quitar foto</label><% } %>
      <small>Una buena foto, con luz natural y fondo limpio, multiplica las consultas.</small>
    </div>
    <label class="field"><span>Nombre *</span><input name="name" required maxlength="100" value="<%= product.name || '' %>" placeholder="Zapatillas running talle 38 al 44"></label>
    <label class="field"><span>Descripción</span><textarea name="description" rows="4" maxlength="1500" placeholder="Material, talles, colores, marca, garantía…"><%= product.description || '' %></textarea></label>
    <div class="row2">
      <label class="field"><span>Precio ($)</span><input name="price" inputmode="numeric" value="<%= product.price || '' %>" placeholder="Vacío = consultar"></label>
      <label class="field"><span>Aclaración del precio</span><input name="price_note" maxlength="60" value="<%= product.price_note || '' %>" placeholder="por kg, desde, efectivo…"></label>
    </div>
    <label class="field"><span>Disponibilidad</span>
      <select name="availability">
        <% [['disponible', 'Disponible'], ['pocas', 'Últimas unidades'], ['a_pedido', 'A pedido'], ['sin_stock', 'Sin stock']].forEach(function(o){ %><option value="<%= o[0] %>" <%= product.availability === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
      </select>
    </label>
    <label class="check"><input type="checkbox" name="active" value="1" <%= product.active !== 0 ? 'checked' : '' %>> Publicado (visible en Pulso)</label>
    <div class="form-actions">
      <button class="btn btn-accent btn-lg">Guardar</button>
      <% if (!product.id) { %><button class="btn btn-ghost" name="otro" value="1">Guardar y cargar otro</button><% } %>
      <a class="btn btn-ghost" href="/panel/productos">Cancelar</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
