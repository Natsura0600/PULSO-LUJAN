<%- include('../partials/header') %>
<%- include('../partials/panel-nav') %>
<div class="wrap panel-body">
  <% if (!limits.promos) { %>
  <div class="card pad locked">
    <h2>🔒 Promociones</h2>
    <p>Publicá descuentos y campañas con fecha, condiciones y código de canje para medir cuántos clientes vinieron por Pulso. Incluido en Comercio Pro.</p>
    <a class="btn btn-accent" href="/panel/plan">Ver planes</a>
  </div>
  <% } else { %>
  <div class="panel-grid">
    <form class="card form-card" method="post" action="/panel/promociones" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2>Nueva promoción</h2>
      <label class="field"><span>Título *</span><input name="title" required maxlength="100" placeholder="20% off en camperas"></label>
      <label class="field"><span>Descripción</span><textarea name="description" rows="2" maxlength="600"></textarea></label>
      <label class="field"><span>Condiciones *</span><textarea name="conditions" rows="2" required maxlength="600" placeholder="Pago en efectivo. No acumulable. Hasta agotar stock."></textarea></label>
      <div class="row2">
        <label class="field"><span>Desde *</span><input type="date" name="starts_at" required value="<%= today %>"></label>
        <label class="field"><span>Hasta *</span><input type="date" name="ends_at" required></label>
      </div>
      <label class="field"><span>Código de canje</span><input name="code" maxlength="20" placeholder="Se genera solo si lo dejás vacío"></label>
      <label class="field"><span>Imagen</span><input type="file" name="photo" accept="image/*"></label>
      <button class="btn btn-accent">Publicar promoción</button>
    </form>
    <div class="card pad">
      <h2>Registrar canje</h2>
      <p class="small muted">Cuando un cliente te muestre el código, registralo para contar cuántos vinieron por Pulso.</p>
      <form method="post" action="/panel/canje" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input class="input" name="code" placeholder="Código" required>
        <button class="btn btn-primary">Registrar</button>
      </form>
    </div>
  </div>
  <% } %>

  <% if (promos.length) { %>
  <h2 class="h2-sec">Mis promociones</h2>
  <div class="table-wrap"><table class="table">
    <tr><th>Promoción</th><th>Vigencia</th><th>Código</th><th class="num">Canjes</th><th></th></tr>
    <% promos.forEach(function(p){ const live = p.starts_at <= today && p.ends_at >= today; %>
    <tr>
      <td><strong><%= p.title %></strong><br><span class="small muted"><%= p.conditions %></span></td>
      <td class="nowrap"><span class="tag <%= live ? 'tag-open' : (p.starts_at > today ? 'tag-warn' : 'tag-closed') %>"><%= live ? 'Vigente' : (p.starts_at > today ? 'Programada' : 'Finalizada') %></span><br><span class="small"><%= fmtDate(p.starts_at) %> – <%= fmtDate(p.ends_at) %></span></td>
      <td><code><%= p.code %></code></td>
      <td class="num"><%= p.canjes %></td>
      <td class="nowrap">
        <% if (live) { %><form method="post" action="/panel/promociones/<%= p.id %>/finalizar" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm">Finalizar</button></form><% } %>
        <form method="post" action="/panel/promociones/<%= p.id %>/borrar" class="inline" data-confirm="¿Eliminar esta promoción?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm danger">Eliminar</button></form>
      </td>
    </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>
<%- include('../partials/footer') %>
